rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players can read only their own save. All writes go through Cloud Functions
    // (Admin SDK bypasses these rules), so clients can never edit coins/crops directly.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
